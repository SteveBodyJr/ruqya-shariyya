    <!-- About -->
    <string name="about_sources">About and sources</string>
    <string name="about_sources_short">Where every text comes from and how it was checked</string>
    <string name="about_checked_title">How the texts were checked</string>
    <string name="about_checked">No Quran or hadith text in this app was typed by hand. Every verse comes from the Tanzil Uthmani text and from the King Fahd Complex (Madinah) text, and the two were compared letter by letter, and again with quran.com. Every supplication and quoted hadith was matched word for word with the narration it cites, and checked on sunnah.com. The 99 names were matched with Ibn Uthaymeen\'s list and with the verse or hadith each comes from.</string>
    <string name="src_tanzil_title">Quran text: Tanzil Project</string>
    <string name="src_tanzil">Uthmani text, used unchanged for the Amiri, Scheherazade and Noto fonts. tanzil.net</string>
    <string name="src_kfgqpc_title">Quran text and font: King Fahd Complex, Madinah</string>
    <string name="src_kfgqpc">Uthmanic Hafs text and font (version 18), as in the Madinah Mushaf.</string>
    <string name="src_translations_title">Translations</string>
    <string name="src_translations">English: Sahih International. Kiswahili: Sheikh Ali Muhsin Al-Barwani. Through tanzil.net.</string>
    <string name="src_translit_title">Transliteration</string>
    <string name="src_translit">Transliteration of the verses from tanzil.net (letters that are written but not pronounced are left out).</string>
    <string name="src_hadith_title">Hadith</string>
    <string name="src_hadith">Sahih al-Bukhari, Sahih Muslim, Sunan Abi Dawud, Jami\' at-Tirmidhi and Sunan Ibn Majah, with the numbering and gradings of sunnah.com.</string>
    <string name="src_names_title">The 99 names</string>
    <string name="src_names">Shaykh Muhammad ibn Salih al-Uthaymeen, al-Qawa\'id al-Muthla fi Sifat Allah wa Asma\'ihi al-Husna, rule six.</string>
    <string name="src_audio_title">Recitation</string>
    <string name="src_audio">Mishary Rashid Alafasy, verse by verse, from everyayah.com.</string>
    <string name="src_guide_title">The evil-eye guide</string>
    <string name="src_guide">The evil-eye session follows the guide \'Ruqyah sahihi kwa kujitibu na kijicho\' (a self-ruqya guide according to the Quran and Sunnah, with the understanding of the Salaf).</string>
    <string name="src_fonts_title">Fonts</string>
    <string name="src_fonts">KFGQPC Uthmanic Script Hafs (King Fahd Complex). Amiri Quran, Scheherazade New, Noto Naskh Arabic and Plus Jakarta Sans under the SIL Open Font License.</string>
    <string name="about_disclaimer_title">Please note</string>
    <string name="about_disclaimer">Ruqya is worship and a means of asking Allah for healing; there is no promise of recovery within a fixed time. It does not replace medical care: if symptoms continue or are severe, see a doctor too. This app does not diagnose anything. If you find a mistake, please report it so it can be corrected.</string>
