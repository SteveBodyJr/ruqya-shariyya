    <!-- About -->
    <string name="about_sources">Kuhusu na vyanzo</string>
    <string name="about_sources_short">Kila andiko limetoka wapi na lilivyothibitishwa</string>
    <string name="about_checked_title">Jinsi maandishi yalivyothibitishwa</string>
    <string name="about_checked">Hakuna andiko la Qur\'an wala hadith katika programu hii lililoandikwa kwa mkono. Kila aya imetoka katika maandishi ya Uthmani ya Tanzil na katika maandishi ya King Fahd Complex (Madina), na mawili hayo yalilinganishwa herufi kwa herufi, kisha tena na quran.com. Kila dua na hadith iliyonukuliwa ililinganishwa neno kwa neno na riwaya inayoitaja, na ikathibitishwa katika sunnah.com. Majina 99 yalilinganishwa na orodha ya Ibn Uthaymeen na aya au hadith ambamo kila jina limetoka.</string>
    <string name="src_tanzil_title">Maandishi ya Qur\'an: Tanzil</string>
    <string name="src_tanzil">Maandishi ya Uthmani, yametumika bila kubadilishwa kwa hati za Amiri, Scheherazade na Noto. tanzil.net</string>
    <string name="src_kfgqpc_title">Maandishi na hati ya Qur\'an: King Fahd Complex, Madina</string>
    <string name="src_kfgqpc">Maandishi na hati ya Uthmanic Hafs (toleo la 18), kama katika Msahafu wa Madina.</string>
    <string name="src_translations_title">Tafsiri</string>
    <string name="src_translations">Kiingereza: Sahih International. Kiswahili: Sheikh Ali Muhsin Al-Barwani. Kupitia tanzil.net.</string>
    <string name="src_translit_title">Matamshi</string>
    <string name="src_translit">Matamshi ya aya kutoka tanzil.net (herufi zinazoandikwa lakini hazitamkwi zimeachwa).</string>
    <string name="src_hadith_title">Hadith</string>
    <string name="src_hadith">Sahih al-Bukhari, Sahih Muslim, Sunan Abi Dawud, Jami\' at-Tirmidhi na Sunan Ibn Majah, kwa namba na madaraja ya sunnah.com.</string>
    <string name="src_names_title">Majina 99</string>
    <string name="src_names">Sheikh Muhammad ibn Salih al-Uthaymeen, al-Qawa\'id al-Muthla fi Sifat Allah wa Asma\'ihi al-Husna, kanuni ya sita.</string>
    <string name="src_audio_title">Kisomo</string>
    <string name="src_audio">Mishary Rashid Alafasy, aya kwa aya, kutoka everyayah.com.</string>
    <string name="src_guide_title">Mwongozo wa kijicho</string>
    <string name="src_guide">Hatua za kijicho zinafuata mwongozo \'Ruqyah sahihi kwa kujitibu na kijicho\' (mwongozo wa kujisomea kwa mujibu wa Qur\'an na Sunnah, kwa ufahamu wa Salafus-Swaalih).</string>
    <string name="src_fonts_title">Hati</string>
    <string name="src_fonts">KFGQPC Uthmanic Script Hafs (King Fahd Complex). Amiri Quran, Scheherazade New, Noto Naskh Arabic na Plus Jakarta Sans chini ya leseni ya SIL Open Font.</string>
    <string name="about_disclaimer_title">Tafadhali zingatia</string>
    <string name="about_disclaimer">Ruqyah ni ibada na sababu ya kuomba uponyaji; hakuna ahadi ya kupona ndani ya muda maalumu. Haichukui nafasi ya matibabu: ikiwa dalili zinaendelea au ni kali, mwone daktari pia. Programu hii haitambui ugonjwa wowote. Ukiona kosa, tafadhali liripoti ili lirekebishwe.</string>
